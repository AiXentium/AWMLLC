# Public build settings: build.mjs maps these to their VITE_ aliases.
# In Vercel, select Production/Preview scopes as appropriate and redeploy.
SUPABASE_PROJECT_ID=gykyusczrrqkkfuktukc
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=https://gykyusczrrqkkfuktukc.supabase.co
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# --- Paid OCR providers (read CLIENT-SIDE via import.meta.env in src/lib/ocr/providers.ts) ---
# Google Document AI — set all four to activate; unset = free Tesseract stack
VITE_GOOGLE_DOCAI_API_KEY=
VITE_GOOGLE_DOCAI_PROJECT=
VITE_GOOGLE_DOCAI_LOCATION=
VITE_GOOGLE_DOCAI_PROCESSOR_ID=
# Azure Document Intelligence (prebuilt-read) — alternative to Google
VITE_AZURE_DOCINTEL_ENDPOINT=
VITE_AZURE_DOCINTEL_KEY=

# --- Server-only keys (process.env, never VITE_ prefixed) ---
# Set these as private server variables; do not bake them into the browser build.
# AI providers: free-first rotation OpenRouter -> Gemini -> Groq; OpenAI/Anthropic last-resort
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOVABLE_API_KEY=
# Supabase service role — server functions only (src/integrations/supabase/client.server.ts)
SUPABASE_SERVICE_ROLE_KEY=
# Dropbox / Google Drive OAuth + token encryption
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
APP_USER_CONNECTION_KEY_SECRET=
GOOGLE_DRIVE_APP_USER_CONNECTOR_CLIENT_API_KEY=

# Optional lead notifications (server runtime only)
GMAIL_USER=
GMAIL_APP_PASSWORD=
SITE_URL=
LEAD_NOTIFY_EMAIL=
LEAD_NOTIFY_SMS=

# Deployment/database administration only; keep separate from application runtime.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
SUPABASE_ACCESS_TOKEN=
# Existing Supabase Auth user to promote with auth:admin.
ADMIN_USER_ID=

# Optional direct PostgreSQL tools; the app uses the HTTPS Supabase API.
PGHOST=db.gykyusczrrqkkfuktukc.supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=
